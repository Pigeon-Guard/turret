# Messaging Configuration
MQTT_HOST=message
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=pguard
MQTT_CLIENT_ID=pguard
MQTT_WEBSOCKET_PORT=8083
MQTT_WEBSOCKET_PATH=mqtt

# Camera and Stream Configuration
HLS_URL=http://localhost:7777/stream/index.m3u8

# Timing Configuration
OWNER_TIMEOUT_SEC=2.0
STEP_INTERVAL_SEC=0.05
STEP_DEG=2.0

# GPIO Pin Configuration
PAN_PIN=12
TILT_PIN=13
TRIGGER_PIN=18
TRIGGER_ACTIVE_HIGH=1
TRIGGER_PULSE_MS=180

# Servo Limits (degrees)
PAN_MIN=-85
PAN_MAX=85
TILT_MIN=-60
TILT_MAX=60

# Backend Configuration
# Options: auto, pigpio, mock, simulate
SERVO_BACKEND=auto
